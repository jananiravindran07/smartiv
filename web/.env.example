# =============================================================================
# SMART IV MONITORING SYSTEM - WEB ENVIRONMENT TEMPLATE
# Academic Prototype - Not a Certified Medical Device
# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
#   cp .env.example .env.local
#
# SECURITY
# Only the ANON key belongs here. The anon key is not a secret in the Supabase
# sense: it is designed to be shipped to browsers, and RLS is what stops it from
# reading anything the signed-in user may not see.
#
# The SERVICE_ROLE key must NEVER appear in this file, in web/, in mobile/, in
# firmware, or anywhere in the repository. It bypasses RLS entirely. It exists
# only as an Edge Function secret:
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<value>
#
# User accounts are created through the admin-create-user Edge Function, which
# reads that secret server-side.
# =============================================================================

# Supabase project URL, e.g. http://127.0.0.1:54321 for local development
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Public anon key. Safe to ship; subject to RLS.
VITE_SUPABASE_ANON_KEY=your-anon-key
