NODE_ENV=development
PORT=3001

# SQLite file. Swap to Postgres later by changing the driver in src/db/index.ts.
DB_PATH=./data/smartiv.sqlite

# REQUIRED. At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# true = the simulator produces readings so the app runs with no hardware.
# false = real Arduino/ESP32 units POST to /api/readings.
SIMULATE=true

# Optional overrides
# WEB_DIST=../web/dist
# OFFLINE_AFTER_MS=10000
# LOGIN_WINDOW_MS=900000
# LOGIN_ATTEMPTS=10
# Secure follows NODE_ENV. Set false only to serve a production build over
# plain HTTP, for example a ward TV on an isolated LAN.
# SECURE_COOKIE=false

# Optional. Sets one shared password for every demo user created by db:seed.
# When unset, the seed script generates a strong password and prints it once.
# SEED_DEMO_PASSWORD=
